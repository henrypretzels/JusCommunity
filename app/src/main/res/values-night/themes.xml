<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode -->
    <style name="Base.Theme.JusCom" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Professional Legal Theme (Dark) -->
        <item name="colorPrimary">@color/legal_blue_light</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/primary_blue_dark</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/dark_gray</item>
        <item name="android:colorBackground">@color/primary_blue_dark</item>
        <item name="colorOnBackground">@color/light_gray</item>
        <item name="colorSurface">@color/primary_blue</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/dark_gray</item>
        <item name="colorOnSurfaceVariant">@color/medium_gray</item>
    </style>

    <!-- The final theme inherits from the base theme -->
    <style name="Theme.JusCom" parent="Base.Theme.JusCom" />

</resources>
